{
  "name": "mono",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:security": "node scripts/security/run.mjs",
    "test:security:ui": "node scripts/security/run.mjs --ui",
    "test:security:live": "node scripts/security/run.mjs --live",
    "security:gate": "node scripts/security/gate.mjs",
    "test:send": "node scripts/security/send/prepare.mjs && python3 scripts/security/send/send-e2e.py"
  },
  "dependencies": {
    "@noble/hashes": "^1.7.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "bigint-buffer": "file:vendor/bigint-buffer",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "vite-plugin-node-polyfills": "^0.23.0"
  }
