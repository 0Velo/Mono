{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/v1/config",
      "destination": "/api/v1/config"
    },
    {
      "source": "/v1/subscriptions",
      "destination": "/api/v1/subscriptions"
    },
    {
      "source": "/v1/subscriptions/:id",
      "destination": "/api/v1/subscriptions/:id"
    },
    {
      "source": "/v1/watch",
      "destination": "/api/v1/watch"
    },
    {
      "source": "/v1/webhooks/helius",
      "destination": "/api/webhooks/helius"
    }
  ],
  "schedules": {
    "push-scan": {
      "schedule": "*/15 * * * *",
      "path": "/api/cron/scan",
      "requestMethod": "GET"
    }
  },
  "crons": [
    {
      "path": "/api/cron/scan",
      "schedule": "0 1 * * *"
    }
  ]
}
