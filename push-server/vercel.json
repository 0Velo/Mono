{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/v1/config", "destination": "/api/v1/config" },
    { "source": "/v1/subscriptions", "destination": "/api/v1/subscriptions" },
    { "source": "/v1/subscriptions/:id", "destination": "/api/v1/subscriptions/:id" }
  ],
  "crons": [
    { "path": "/api/cron/scan", "schedule": "0 1 * * *" }
  ]
}
